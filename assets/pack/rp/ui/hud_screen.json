{
  "namespace": "hud",

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": { "nl_hud_block@nl_hud.block": {} }
      }
    ]
  },

  "hud_title_text": {
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(((#hud_title_text_string - '§r§N§C§L') - '§r§N§C§R') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  }
}
